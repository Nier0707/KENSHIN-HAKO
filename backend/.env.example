# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (managed provider — e.g. Supabase/Neon/Railway)
DATABASE_URL="postgresql://user:password@host:5432/kenshin_hako"

# Long, random secret — used to sign JWTs. Generate with: openssl rand -hex 32
JWT_SECRET="replace-with-a-long-random-value"

# Access token lifetime
JWT_EXPIRES_IN="8h"

# Port the API listens on
PORT=4000

# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGINS="http://localhost:5173"

# Used only by prisma/seed.ts to create the first Owner account
SEED_OWNER_EMAIL="owner@kenshinhako.com"
SEED_OWNER_PASSWORD="ChangeMe123!"
